---
import { dictionary, url, type Locale } from "@/i18n";
import { site } from "@/config/site";
import Button from "@/components/ui/Button.astro";
import Ecosystem from "@/components/sections/Ecosystem.astro";
import Solutions from "@/components/sections/Solutions.astro";
import Process from "@/components/sections/Process.astro";
import CallToAction from "@/components/sections/CallToAction.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dictionary(locale);
---

<section class="hero container">
  <div class="hero-copy">
    <p class="hero-tag">
      <span></span>
      {t.hero.tag}
    </p>
    <h1>
      {t.hero.line1}
      <br />
      <span>{t.hero.line2}</span>
      <br />
      {t.hero.line3}
    </h1>
    <p class="hero-description">{t.hero.text}</p>
    <div class="hero-buttons">
      <Button href={url(locale, "contact")}>{t.common.cta}</Button>
      <Button href="#solutions" variant="text">
        {t.hero.secondary}
      </Button>
    </div>
    <p class="hero-note">
      <span aria-hidden="true">↳</span>
      {t.hero.note}
    </p>
  </div>
  <Ecosystem {t} />
</section>
<section class="container proof-strip" aria-label={t.about.tag}>
  {t.proof.map((item) => (
    <div>
      <strong>{item.value}</strong>
      <span>{item.label}</span>
    </div>
  ))}
</section>
<Solutions {locale} />
<section class="container approach-section section">
  <div class="experience-visual" aria-hidden="true">
    <span class="experience-years">
      10<span>+</span>
    </span>
    <div class="experience-lines">
      <i></i>
      <i></i>
      <i></i>
      <i></i>
    </div>
    <span class="experience-caption">Prasentace.</span>
  </div>
  <div data-reveal>
    <p class="eyebrow">{t.about.tag}</p>
    <h2>{t.about.title}</h2>
    <p class="lead">{t.about.body}</p>
    <Button href={url(locale, "about")} variant="text">
      {t.nav.about}
    </Button>
  </div>
</section>
<Process {locale} />
<section class="technology-strip container">
  <p>{t.about.technology}</p>
  <div>
    {site.technologies.map((name) => (
      <span>{name}</span>
    ))}
  </div>
</section>
<CallToAction {locale} />
