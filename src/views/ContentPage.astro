---
import { dictionary, url, type Locale, type PageId } from "@/i18n";
import { site } from "@/config/site";
import Solutions from "@/components/sections/Solutions.astro";
import Process from "@/components/sections/Process.astro";
import CallToAction from "@/components/sections/CallToAction.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
interface Props {
  locale: Locale;
  page: PageId;
  solutionId?: string;
}
const { locale, page, solutionId } = Astro.props;
const t = dictionary(locale);
const solution = t.solutions.items.find((item) => item.id === solutionId);
const content =
  page === "process" ? t.process : page === "about" ? t.about : t.solutions;
---

<section class="container page-intro">
  <p class="eyebrow">{solution ? t.nav.solutions : content.tag}</p>
  <h1>{solution ? solution.title : content.title}</h1>
  <p class="lead">{solution ? solution.description : content.text}</p>
  {solution && <Button href={url(locale, "contact")}>{t.common.cta}</Button>}
</section>
{page === "solutions" && !solution && <Solutions {locale} heading={false} />}
{solution && (
  <section class="container section detail-grid">
    <div data-reveal>
      <span class="service-icon large">
        <Icon name={solution.id} size={32} />
      </span>
      <h2>{solution.short}</h2>
      <p class="lead">{solution.detail}</p>
      <div class="outcome">
        <p class="eyebrow">{t.common.deliverables}</p>
        <p>{solution.outcome}</p>
      </div>
    </div>
    <div class="feature-panel" data-reveal>
      <h3>{t.common.detail}</h3>
      {solution.features.map((feature) => (
        <div class="feature-row">
          <Icon name="check" size={20} />
          <span>{feature}</span>
        </div>
      ))}
    </div>
  </section>
)}
{page === "process" && <Process {locale} detailed />}
{page === "about" && (
  <>
    <section class="container section about-intro">
      <div class="big-stat">
        10<span>+</span>
        <p>{t.proof[0].label}</p>
      </div>
      <div>
        <p class="lead">{t.about.body}</p>
        <p class="lead">{t.about.body2}</p>
      </div>
    </section>
    <section class="container values-grid">
      {t.about.values.map((item, i) => (
        <article data-reveal>
          <span class="eyebrow">0{i + 1}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </section>
    <section class="container section technology-strip">
      <h2>{t.about.technology}</h2>
      <p>{t.about.technologyText}</p>
      <div>
        {site.technologies.map((name) => (
          <span>{name}</span>
        ))}
      </div>
    </section>
  </>
)}
{solution && (
  <section class="container section">
    <p class="eyebrow">{t.common.related}</p>
    <div class="related-links">
      {t.solutions.items
        .filter((item) => item.id !== solution.id)
        .map((item) => (
          <a href={url(locale, "solutions", item.id)}>
            {item.title}
            <Icon name="diagonal" size={20} />
          </a>
        ))}
    </div>
  </section>
)}
<CallToAction {locale} />
