---
/**
 * Značka webu s logem a názvem.
 *
 * Odkaz na domovskou stránku dostává přes prop, protože v hlavičce míří na
 * kořen v jazyce návštěvníka a v patičce na domovskou stránku téhož jazyka.
 */
import { site } from "../../../config/site";

/** Vstupní parametry značky webu. */
interface Props {
  /** URL cílové stránky značky. */
  href: string;
}

const { href } = Astro.props;
---

<a class="wordmark brand-logo" href={href} aria-label={site.name}>
  <img src="/brand/mark.svg" width="48" height="48" alt="" class="brand-mark" />
  <span class="brand-name">
    {site.name}
    <span class="logo-dot" aria-hidden="true">
      .
    </span>
  </span>
</a>
