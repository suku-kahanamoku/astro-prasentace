---
/**
 * Obsah chybové stránky 404.
 *
 * Nabízí návrat na domovskou stránku v každém podporovaném jazyce, takže
 * návštěvník se neztratí ani na cizojazyčné adrese. Jazyk každého tlačítka
 * je uveden atributem `lang`, aby se při změně jazyka označil i jazyk cílové
 * stránky pro čtečky obrazovky.
 */
import { dictionary } from "../providers/translations";
import { locales, type Locale } from "../../LangModule/providers/locale";
import { url } from "../../../config/routes";

/** Vstupní parametry chybové stránky. */
interface Props {
  /** Jazyk, ve kterém je chybová stránka vykreslena. */
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionary(locale);
---

<section class="container page-intro not-found">
  <p class="eyebrow">404</p>
  <h1>{t.notFound.title}</h1>
  <p class="lead">{t.notFound.text}</p>
  <div class="hero-buttons">
    {locales.map((code) => (
      <a class="button button-secondary" href={url(code)} lang={code}>
        {dictionary(code).back}
      </a>
    ))}
  </div>
</section>
