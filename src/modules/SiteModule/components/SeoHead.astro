---
/**
 * Kompletní hlavička dokumentu: title, description, canonical, hreflang,
 * Open Graph, Twitter card a strukturovaná data.
 *
 * Záměr je mít jediné místo, kde se rozhoduje o meta datech webu.
 * Standardní hodnoty přebírá ze slovníku (`seo[page]`), ale volající je může
 * přepsat – například detail kapacity má vlastní `seoTitle` a popis.
 * Příznak `noindex` potlačí canonical i hreflang (používá se pro 404)
 * a zároveň vynechá `WebSite` a `BreadcrumbList` ve strukturovaných datech.
 */
import { theme } from "../../UIModule/config/theme";
import { dictionary } from "../providers/translations";
import { locales, type Locale } from "../../LangModule/providers/locale";
import { url, type PageId } from "../../../config/routes";
import { site } from "../../../config/site";
import { breadcrumbs } from "../providers/breadcrumbs";

/** Vstupní parametry hlavičky dokumentu. */
interface Props {
  /** Jazyk stránky; určuje překlady, canonical i `og:locale`. */
  locale: Locale;
  /** Sekce stránky; zdroj výchozího title a description. */
  page: PageId;
  /** Volitelné ID kapacity pro canonical a hreflang. */
  solutionId?: string;
  /** Název kapacity; potřebný pro breadcrumbs ve strukturovaných datech. */
  solutionTitle?: string;
  /** Vlastní title; přebíjí překlad ze slovníku. */
  title?: string;
  /** Vlastní description; přebíjí překlad ze slovníku. */
  description?: string;
  /** Příznak stránek mimo index; potlačí canonical, hreflang a breadcrumbs. */
  noindex?: boolean;
}

const { locale, page, solutionId, noindex = false } = Astro.props;
const t = dictionary(locale);
const title = `${Astro.props.title || t.seo[page].title} | Prasentace`;
const description = Astro.props.description || t.seo[page].description;
const canonical = new URL(url(locale, page, solutionId), Astro.site);
const breadcrumbItems = noindex
  ? []
  : breadcrumbs(locale, page, solutionId, Astro.props.solutionTitle);
const socialImage = new URL(`/social/og-${locale}.png`, Astro.site);
const socialImageAlt = `${site.name} — ${t.seo.home.title}`;
const organizationId = new URL("/#organization", Astro.site).href;
/** Základní schema.org záznam organizace; sdílený všemi stránkami. */
const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": organizationId,
  name: site.name,
  logo: new URL("/brand/mark.svg", Astro.site).href,
  url: Astro.site?.href,
  identifier: site.registrationId,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
};
/**
 * Pole strukturovaných dat pro JSON-LD.
 * Kromě organizace zahrnuje i `WebSite` (jen na domovské stránce)
 * a `BreadcrumbList` (kde existuje cesta).
 */
const structuredData = [
  schema,
  ...(!noindex && page === "home"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "@id": new URL("/#website", Astro.site).href,
          name: site.name,
          url: Astro.site?.href,
          inLanguage: locales,
          publisher: { "@id": organizationId },
        },
      ]
    : []),
  ...(breadcrumbItems.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement: breadcrumbItems.map((item, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: item.name,
            item: new URL(item.href, Astro.site).href,
          })),
        },
      ]
    : []),
];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content={theme.color} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
{noindex ? (
  <meta name="robots" content="noindex, follow" />
) : (
  <>
    <link rel="canonical" href={canonical} />
    {locales.map((code) => (
      <link
        rel="alternate"
        hreflang={code}
        href={new URL(url(code, page, solutionId), Astro.site)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(url("cs", page, solutionId), Astro.site)}
    />
  </>
)}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Prasentace" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta
  property="og:locale"
  content={{ cs: "cs_CZ", en: "en_GB", de: "de_DE" }[locale]}
/>
<meta property="og:image" content={socialImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={socialImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={socialImageAlt} />
<script
  type="application/ld+json"
  set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
/>
