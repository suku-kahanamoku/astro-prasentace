---
import { dictionary } from "../providers/translations";
import type { Locale } from "../../LangModule/config";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dictionary(locale);

import { site } from "../../../config/site";
---

<section class="container section technology-strip">
  <h2>{t.about.technology}</h2>
  <p>{t.about.technologyText}</p>
  <div>
    {site.technologies.map((name) => (
      <span>{name}</span>
    ))}
  </div>
</section>
