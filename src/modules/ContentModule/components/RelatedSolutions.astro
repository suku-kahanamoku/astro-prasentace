---
import { dictionary } from "../providers/translations";
import type { Locale } from "../../LangModule/config";
import type { Solution } from "../providers/translations";
interface Props {
  locale: Locale;
  solution: Solution;
}
const { locale, solution } = Astro.props;
const t = dictionary(locale);

import { url } from "../../../config/routes";
---

<section class="container section">
  <p class="eyebrow">{t.common.related}</p>
  <div class="related-links">
    {t.solutions.items
      .filter((item) => item.id !== solution.id)
      .map((item) => (
        <a href={url(locale, "solutions", item.id)}>{item.title}</a>
      ))}
  </div>
</section>
