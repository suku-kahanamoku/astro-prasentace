---
/**
 * Krátký pás technologií na domovské stránce.
 *
 * Názvy technologií pocházejí z `src/config/site.ts`, protože se mezi jazyky
 * nepřekládají; překlad je jen úvodní text.
 */
import { dictionary } from "../providers/translations";
import type { Locale } from "../../LangModule/config";

/** Vstupní parametry pásu technologií. */
interface Props {
  /** Jazyk stránky; určuje úvodní text. */
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionary(locale);

import { site } from "../../../config/site";
---

<section class="technology-strip container">
  <p>{t.about.technology}</p>
  <div>
    {site.technologies.map((name) => (
      <span>{name}</span>
    ))}
  </div>
</section>
