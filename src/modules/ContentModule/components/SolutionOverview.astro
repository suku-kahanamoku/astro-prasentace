---
/**
 * Přehled jedné kapacity v detailní stránce: ikona, popis, výsledek a seznam
 * vlastností.
 *
 * Název ikony se bere přímo z `solution.id`, takže ID kapacity musí odpovídat
 * názvu v sadě ikon UIModule; neznámé ID se vykreslí výchozí šipkou.
 */
import { dictionary } from "../providers/translations";
import type { Locale } from "../../LangModule/config";
import type { Solution } from "../providers/translations";

/** Vstupní parametry přehledu kapacity. */
interface Props {
  /** Jazyk stránky; určuje nadpisy sekcí, data kapacity se přebírají z props. */
  locale: Locale;
  /** Kapacita, kterou přehled popisuje. */
  solution: Solution;
}

const { locale, solution } = Astro.props;
const t = dictionary(locale);

import Icon from "../../UIModule/components/Icon.astro";
---

<section class="container section detail-grid">
  <div data-reveal>
    <span class="service-icon large">
      <Icon name={solution.id} size={32} />
    </span>
    <h2>{solution.short}</h2>
    <p class="lead">{solution.detail}</p>
    <div class="outcome">
      <p class="eyebrow">{t.common.deliverables}</p>
      <p>{solution.outcome}</p>
    </div>
  </div>
  <div class="feature-panel" data-reveal>
    <h3>{t.common.detail}</h3>
    {solution.features.map((feature) => (
      <div class="feature-row">
        <Icon name="check" size={20} />
        <span>{feature}</span>
      </div>
    ))}
  </div>
</section>
