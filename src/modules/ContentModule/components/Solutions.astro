---
/**
 * Mřížka nabízených kapacit.
 *
 * Používá se na domovské stránce i jako celý obsah přehledové stránky
 * kapac. Prop `heading` řídí, zda se vykreslí nadpis sekce: na přehledové
 * stránce ho už má úvod, proto se vypne a nadpisy karet se zvednou na `h2`.
 * První karta navíc obsahuje dekorační ilustraci rozhraní.
 */
import { dictionary } from "../providers/translations";
import { type Locale } from "../../LangModule/providers/locale";
import { url } from "../../../config/routes";
import Icon from "../../UIModule/components/Icon.astro";
import SectionHeading from "../../UIModule/components/SectionHeading.astro";

/** Vstupní parametry mřížky kapac. */
interface Props {
  /** Jazyk stránky; určuje texty a URL detailů kapac. */
  locale: Locale;
  /** Zda vykreslit nadpis sekce; výchozí `true`. */
  heading?: boolean;
}

const { locale, heading = true } = Astro.props;
const t = dictionary(locale);
/** Úroveň nadpisu karty: bez nadpisu sekce se karty zvednou o jednu úroveň. */
const CardHeading = heading ? "h3" : "h2";
---

<section class="section container" id="solutions">
  {heading && (
    <SectionHeading
      tag={t.solutions.tag}
      title={t.solutions.title}
      text={t.solutions.text}
    />
  )}
  <div class="solutions-grid">
    {t.solutions.items.map((item, i) => (
      <a
        class:list={["solution-card", `solution-${item.id}`]}
        href={url(locale, "solutions", item.id)}
        data-reveal
      >
        <div class="card-top">
          <span class="service-icon">
            <Icon name={item.id} size={26} />
          </span>
          <span class="card-number">0{i + 1}</span>
        </div>
        <div class="card-copy">
          <CardHeading class="card-title">{item.title}</CardHeading>
          <p>{item.description}</p>
        </div>
        <div class="card-bottom">
          <div class="tags">
            {item.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </div>
        {i === 0 && (
          <div class="card-art" aria-hidden="true">
            <div class="art-sidebar">
              <i></i>
              <i></i>
              <i></i>
              <i></i>
            </div>
            <div class="art-content">
              <div class="art-topline"></div>
              <div class="art-bars">
                <i></i>
                <i></i>
                <i></i>
                <i></i>
                <i></i>
                <i></i>
              </div>
              <div class="art-lines">
                <i></i>
                <i></i>
              </div>
            </div>
          </div>
        )}
      </a>
    ))}
  </div>
</section>
