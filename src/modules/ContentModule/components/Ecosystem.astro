---
/**
 * Ilustrovaná grafika v hlavní sekci webu.
 *
 * Celý vizuál je jeden obrázekek pro čtečky obrazovky (`role="img"` +
 * `aria-label`), jednotlivé karty, čáry a dekorace jsou skryté.
 * Na rozdíl od ostatních sekcí dostává komponenta hotový slovník přes prop,
 * protože ji vykresluje pouze `HeroSection`.
 */
import Icon from "../../UIModule/components/Icon.astro";
import { type Dictionary } from "../providers/translations";

/** Vstupní parametry ilustrované grafiky. */
interface Props {
  /** Již vybraný slovník obsahového modulu pro aktuální jazyk. */
  t: Dictionary;
}

const { t } = Astro.props;
---

<div class="ecosystem" role="img" aria-label={t.hero.visualLabel}>
  <div class="notebook-sheet" aria-hidden="true"></div>
  <span class="notebook-label" aria-hidden="true">
    {t.brand.notebook}
  </span>
  <img
    class="notebook-ink"
    src="/brand/ink.svg"
    width="130"
    height="112"
    alt=""
    aria-hidden="true"
  />
  <div class="orbit orbit-one"></div>
  <div class="orbit orbit-two"></div>
  <div class="orbit orbit-three"></div>
  <svg class="connections" viewBox="0 0 560 530" fill="none" aria-hidden="true">
    <path d="M135 120 Q285 120 285 270 M455 245 Q405 270 285 270 M200 421 Q285 421 285 270" />
    <path
      class="flow-line"
      d="M135 120 Q285 120 285 270 M455 245 Q405 270 285 270 M200 421 Q285 421 285 270"
    />
  </svg>
  <div class="ecosystem-core">
    <img
      src="/brand/mark.svg"
      width="72"
      height="72"
      alt=""
      class="core-brand"
    />
    <strong>Prasentace</strong>
    <span>{t.hero.coreSub}</span>
  </div>
  <div class="floating-card system-card">
    <span class="mini-icon">
      <Icon name="systems" size={20} />
    </span>
    <div>
      <strong>{t.hero.system}</strong>
      <small>{t.hero.systemSub}</small>
    </div>
    <div class="mini-dashboard" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
  <div class="floating-card mobile-card">
    <span class="mini-icon lilac">
      <Icon name="mobile" size={21} />
    </span>
    <strong>{t.hero.mobile}</strong>
    <small>{t.hero.mobileSub}</small>
    <div class="mini-phone" aria-hidden="true">
      <i></i>
      <span></span>
      <span></span>
      <b></b>
    </div>
  </div>
  <div class="floating-card automation-card">
    <span class="mini-icon mint">
      <Icon name="automation" size={20} />
    </span>
    <div>
      <strong>{t.hero.automation}</strong>
      <small>{t.hero.automationSub}</small>
    </div>
    <span class="automation-status" aria-hidden="true">
      <Icon name="check" size={13} />
    </span>
  </div>
  <span class="notebook-note" aria-hidden="true">
    {t.brand.note}
  </span>
  <span class="deco-spark spark-one" aria-hidden="true">
    +
  </span>
  <span class="deco-spark spark-two" aria-hidden="true">
    +
  </span>
  <span class="deco-dot" aria-hidden="true"></span>
</div>
