---
/**
 * Mřížka hodnot na stránce „O nás“.
 *
 * Počítá se automaticky ze slovníku, takže přidání hodnoty stačí udělat jen
 * v překladech pro všechny jazyky.
 */
import { dictionary } from "../providers/translations";
import type { Locale } from "../../LangModule/config";

/** Vstupní parametry mřížky hodnot. */
interface Props {
  /** Jazyk stránky; určuje nadpisy a popisy hodnot. */
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionary(locale);
---

<section class="container values-grid">
  {t.about.values.map((item, i) => (
    <article data-reveal>
      <span class="eyebrow">0{i + 1}</span>
      <h2>{item.title}</h2>
      <p>{item.text}</p>
    </article>
  ))}
</section>
