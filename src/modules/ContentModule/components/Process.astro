---
/**
 * Sekce „Jak pracujeme“ s jednotlivými kroky postupu.
 *
 * Slouží dvěma účelům: jako krátká sekce na domovské stránce a jako podrobná
 * sekce na stránce procesu. Proto má prop `detailed`: v detailní podobě se
 * vykreslí výstup každého kroku a nadpis kroku se zvedne na `h2` (nadpis
 * sekce už v této variantě vykresluje předchozí sekce stránky).
 */
import { dictionary } from "../providers/translations";
import { type Locale } from "../../LangModule/providers/locale";
import SectionHeading from "../../UIModule/components/SectionHeading.astro";

/** Vstupní parametry sekce procesu. */
interface Props {
  /** Jazyk stránky; určuje všechny texty. */
  locale: Locale;
  /** Podrobná varianta pro stránku procesu; výchozí `false`. */
  detailed?: boolean;
}

const { locale, detailed = false } = Astro.props;
const t = dictionary(locale);
/** Úroveň nadpisu kroku: v detailní variantě navazuje přímo na nadpis sekce. */
const StepHeading = detailed ? "h2" : "h3";
---

<section class="section process-section">
  <div class="container">
    {!detailed && (
      <SectionHeading
        tag={t.process.tag}
        title={t.process.title}
        text={t.process.text}
      />
    )}
    <div class:list={["process-grid", { "process-detailed": detailed }]}>
      {t.process.items.map((item, i) => (
        <article class="process-step" data-reveal>
          <div class="step-track">
            <span>0{i + 1}</span>
            <i></i>
          </div>
          <StepHeading class="step-title">{item.title}</StepHeading>
          <p>{item.text}</p>
          {detailed && <div class="step-output">↳ {item.output}</div>}
        </article>
      ))}
    </div>
  </div>
</section>
