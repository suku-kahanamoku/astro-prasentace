---
/**
 * Jedna obsahová podsekce detailu kapacity.
 *
 * Prázdné, čistě datové rozdělení: texty dodává slovník, komponenta je
 * záměrně co nejmenší a funguje i pro právní texty (viz SiteModule).
 */
interface Props {
  /** Obsah podsekce s vlastním nadpisem. */
  section: { title: string; text: string };
}

const { section } = Astro.props;
---

<section class="service-detail" data-reveal>
  <h2>{section.title}</h2>
  <p>{section.text}</p>
</section>
