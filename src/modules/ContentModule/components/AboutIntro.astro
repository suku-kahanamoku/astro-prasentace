---
/**
 * Úvod sekce „O nás“ s hlavním číslem a dvěma odstavci.
 *
 * Číslo „10+“ se bere z první položky seznamu důkazů, aby ho nebylo
 * potřeba duplikovat v překladech.
 */
import { dictionary } from "../providers/translations";
import type { Locale } from "../../LangModule/config";

/** Vstupní parametry úvodu sekce „O nás“. */
interface Props {
  /** Jazyk stránky; určuje všechny texty. */
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionary(locale);
---

<section class="container section about-intro">
  <div class="big-stat">
    10<span>+</span>
    <p>{t.proof[0].label}</p>
  </div>
  <div>
    <p class="lead">{t.about.body}</p>
    <p class="lead">{t.about.body2}</p>
  </div>
</section>
