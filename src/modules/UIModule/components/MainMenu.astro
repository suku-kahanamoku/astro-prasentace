---
/**
 * Hlavní menu webu (hlavička s logem, navigací a přepínačem vzhledu).
 *
 * UIModule záměrně nezná obsah webu: texty a odkazy dodává volající přes props,
 * doplněné sloty `brand`, `language` a `action`. Stejná komponenta tak slouží
 * hlavičce i případným framovaným variantám bez kopírování kódu.
 *
 * Sloty:
 * - `brand` – značka webu odkazující na domovskou stránku,
 * - `language` – přepínač jazyka (slot `language`),
 * - `action` – hlavní výzva v pravé části hlavičky.
 *
 * Chování mobilního panelu zajišťuje `useMainMenu`, který se po každém
 * přechodu mezi stránkami znovu napojí. Blok `<noscript>` rozpadá na širších
 * displejích rozbalovací panel, aby menu fungovalo i bez JavaScriptu.
 */
import "../styles/main-menu.css";
import ThemeToggle from "./ThemeToggle.astro";
import NavigationLinks from "./NavigationLinks.astro";
import type { NavigationItem } from "../types";

/** Vstupní parametry hlavního menu. */
interface Props {
  /** Jazyk webu; předává se přepínači vzhledu. */
  locale: string;
  /** Přístupnostní název hlavní navigace. */
  label: string;
  /** Položky desktopové navigace. */
  items: NavigationItem[];
  /** Položky mobilního panelu; výchozí stejné jako `items`. */
  mobileItems?: NavigationItem[];
  /** `id` panelu, na který odkazuje `aria-controls` tlačítka; výchozí `mobile-navigation`. */
  menuId?: string;
  /** Popisek tlačítka v zavřeném stavu; výchozí `label`. */
  openLabel?: string;
  /** Popisek tlačítka v otevřeném stavu; výchozí `label`. */
  closeLabel?: string;
  /** Přidá třídu `main-menu-framed` pro ohraničenou variantu hlavičky. */
  framed?: boolean;
  /** Zda se má vykreslit slot `action`; výchozí `true`. */
  showAction?: boolean;
}

const {
  locale,
  label,
  items,
  mobileItems = items,
  menuId = "mobile-navigation",
  openLabel = label,
  closeLabel = label,
  framed = false,
  showAction = true,
} = Astro.props;
---

<header
  class:list={["main-menu", "site-header", { "main-menu-framed": framed }]}
  data-main-menu
>
  <div class="header-inner">
    <div class="header-brand">
      <slot name="brand" />
    </div>
    <nav class="desktop-nav" aria-label={label}>
      <NavigationLinks {items} class="nav-link" />
    </nav>
    <div class="header-actions">
      <div class="header-preferences">
        <ThemeToggle {locale} />
        <slot name="language" />
      </div>
      {showAction && Astro.slots.has("action") && (
        <div class="header-primary-action">
          <slot name="action" />
        </div>
      )}
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls={menuId}
        aria-label={openLabel}
        data-open-label={openLabel}
        data-close-label={closeLabel}
        data-menu-toggle
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <nav id={menuId} class="mobile-nav" aria-label={label} hidden>
    <NavigationLinks items={mobileItems} class="nav-link" />
  </nav>
</header>
<script>
  import { useMainMenu } from "../hooks/useMainMenu";
  useMainMenu();
  document.addEventListener("astro:page-load", useMainMenu);
</script>
<noscript>
  <style is:global>
    @media (max-width: 1279px) {
      .main-menu .menu-toggle {
        display: none;
      }
      @layer base {
        /* Vrstvený preflight s !important vyžaduje přepis ve stejné vrstvě. */
        .main-menu .mobile-nav[hidden] {
          display: flex !important;
        }
      }
      .main-menu .mobile-nav[hidden] {
        display: flex !important;
        position: static;
        max-height: none;
        grid-column: 1 / -1;
      }
      .main-menu {
        position: relative;
      }
    }
  </style>
</noscript>
