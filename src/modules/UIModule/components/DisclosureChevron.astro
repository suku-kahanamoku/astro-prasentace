---
/**
 * Šipka indikující stav rozbalovacího prvku.
 *
 * Čistě dekorativní SVG (je odstíněna z `currentColor`), proto je skrytá
 * před čtečkami obrazovky; stav sděluje vlastní `<details>/<summary>`.
 * Otočení při otevření řeší CSS podle atributu `open`.
 */
interface Props {
  /** Volitelná doplňková třída pro umístění v konkrétním rozkladu. */
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={["disclosure-chevron", className]}
  width="16"
  height="16"
  viewBox="0 0 16 16"
  fill="none"
  aria-hidden="true"
>
  <path
    d="m4 6 4 4 4-4"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
