---
/**
 * Ikona z vnitřní sady obrysových symbolů.
 *
 * Cílem je mít jedno místo, kde se definují a kreslí grafické symboly webu:
 * komponenty si předávají jen název. Neznámý název tiše vede k výchozí šipce,
 * aby se ikona nikdy nevykreslila prázdná. Všechny ikony jsou dekorativní
 * a skryté před čtečkami; smysl vždy nese okolní text.
 */
interface Props {
  /** Název ikony ze sady `paths`; výchozí `arrow`. */
  name?: string;
  /** Délka strany čtvercového SVG v pixelech; výchozí 24. */
  size?: number;
  /** Volitelná třída pro zarovnání a barvu v konkrétní sekci. */
  class?: string;
}

const { name = "arrow", size = 24, class: className } = Astro.props;

/** Obrysové cesty jednotlivých ikon ve viewBoxu 24×24. */
const paths: Record<string, string> = {
  arrow: "M5 12h14m-6-6 6 6-6 6",
  diagonal: "M6 18 18 6M6 6h12v12",
  systems: "M3 4h18v16H3zM3 9h18M9 9v11M6 6.5h.01M9 6.5h.01",
  web: "M3 4h18v16H3zM3 9h18m-13 4-2 2 2 2m8-4 2 2-2 2m-3-5-2 6",
  mobile: "M7 2h10v20H7zM10 5h4m-3 14h2",
  automation: "m13 2-9 12h7l-1 8 10-12h-7z",
  support: "M12 3a9 9 0 1 0 8.5 12M12 7v5l3 2m1-11h5v5m0-5-6 6",
  check: "m5 12 4 4L19 6",
  mail: "M3 5h18v14H3zM3 6l9 7 9-7",
  globe:
    "M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18",
  plus: "M12 5v14M5 12h14",
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d={paths[name] || paths.arrow} />
</svg>
