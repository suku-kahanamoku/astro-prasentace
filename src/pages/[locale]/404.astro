---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NotFound from "../../modules/SiteModule/components/NotFoundSection.astro";
import { type Locale } from "../../modules/LangModule/providers/locale";
export const getStaticPaths = () =>
  ["en", "de"].map((locale) => ({ params: { locale }, props: { locale } }));
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<BaseLayout {locale} page="home" title="404" noindex>
  <NotFound {locale} />
</BaseLayout>
