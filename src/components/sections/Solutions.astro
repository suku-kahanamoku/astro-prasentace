---
import { dictionary, url, type Locale } from "@/i18n";
import Icon from "@/components/ui/Icon.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
interface Props {
  locale: Locale;
  heading?: boolean;
}
const { locale, heading = true } = Astro.props;
const t = dictionary(locale);
const CardHeading = heading ? "h3" : "h2";
---

<section class="section container" id="solutions">
  {heading && (
    <SectionHeading
      tag={t.solutions.tag}
      title={t.solutions.title}
      text={t.solutions.text}
    />
  )}
  <div class="solutions-grid">
    {t.solutions.items.map((item, i) => (
      <a
        class:list={["solution-card", `solution-${item.id}`]}
        href={url(locale, "solutions", item.id)}
        data-reveal
      >
        <div class="card-top">
          <span class="service-icon">
            <Icon name={item.id} size={26} />
          </span>
          <span class="card-number">0{i + 1}</span>
        </div>
        <div class="card-copy">
          <CardHeading class="card-title">{item.title}</CardHeading>
          <p>{item.description}</p>
        </div>
        <div class="card-bottom">
          <div class="tags">
            {item.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
          <span class="card-arrow">
            <Icon name="diagonal" size={20} />
          </span>
        </div>
        {i === 0 && (
          <div class="card-art" aria-hidden="true">
            <div class="art-sidebar">
              <i></i>
              <i></i>
              <i></i>
              <i></i>
            </div>
            <div class="art-content">
              <div class="art-topline"></div>
              <div class="art-bars">
                <i></i>
                <i></i>
                <i></i>
                <i></i>
                <i></i>
                <i></i>
              </div>
              <div class="art-lines">
                <i></i>
                <i></i>
              </div>
            </div>
          </div>
        )}
      </a>
    ))}
  </div>
</section>
