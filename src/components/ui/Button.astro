---
import Icon from "./Icon.astro";
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "text";
  class?: string;
}
const { href, variant = "primary", class: className } = Astro.props;
---

<a href={href} class:list={["button", `button-${variant}`, className]}>
  <slot />
  <Icon name="arrow" size={19} />
</a>
