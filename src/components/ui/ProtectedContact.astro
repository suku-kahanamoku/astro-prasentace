---
import { site } from "@/config/site";
interface Props {
  kind: "email" | "phone";
  class?: string;
}
const { kind, class: className } = Astro.props;
const value = site[kind];
const target =
  kind === "email" ? `mailto:${value}` : `tel:${value.replaceAll(" ", "")}`;
const encoded = btoa(target);
---

<span class={className} data-protected-contact={encoded}>
  {Array.from(value).map((character) => (
    <span>{character}</span>
  ))}
</span>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-protected-contact]")
    .forEach((element) => {
      const href = atob(element.dataset.protectedContact || "");
      if (!href.startsWith("mailto:") && !href.startsWith("tel:")) return;
      const link = document.createElement("a");
      link.href = href;
      link.className = element.className;
      link.textContent = element.textContent?.trim() || "";
      element.replaceWith(link);
    });
</script>
