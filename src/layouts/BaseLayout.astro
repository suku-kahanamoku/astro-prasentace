---
/**
 * Základní HTML kostra webu.
 *
 * Skládá kompletní dokument (doctype, hlavičku s SEO a theme bootstrapem,
 * hlavičku webu, breadcrumbs, slot s obsahem a patičku) a načítá globální
 * styly. Všechny lokalizované stránky i 404 jsou skládány touto šablonou,
 * takže je jediným místem, kde se rozhoduje o lang atributu a meta datech.
 *
 * Slot: obsah stránky v jazyce `locale` (sekce skládané z modulů).
 */
import ThemeInit from "../modules/UIModule/components/ThemeInit.astro";
import SeoHead from "../modules/SiteModule/components/SeoHead.astro";

import "@fontsource-variable/manrope";
import "../styles/global.css";
import "../styles/brand.css";
import Header from "../modules/SiteModule/components/Header.astro";
import Footer from "../modules/SiteModule/components/Footer.astro";
import { dictionary } from "../modules/SiteModule/providers/translations";
import { type Locale } from "../modules/LangModule/providers/locale";
import { type PageId } from "../config/routes";

import Breadcrumbs from "../modules/UIModule/components/Breadcrumbs.astro";
import { breadcrumbs } from "../modules/SiteModule/providers/breadcrumbs";

/** Vstupní parametry základní šablony stránky. */
interface Props {
  /** Jazyk stránky; určuje `lang` atribut, překlady i jazykový přepínač. */
  locale: Locale;
  /** Identifikátor sekce; používá se pro navigaci, SEO a breadcrumbs. */
  page: PageId;
  /** Volitelné ID řešení pro detailní stránku řešení. */
  solutionId?: string;
  /** Název řešení; potřebný pro breadcrumbs, je-li `solutionId` zadáno. */
  solutionTitle?: string;
  /** Vlastní `<title>`; když chybí, použije se překlad z `seo[page]`. */
  title?: string;
  /** Vlastní meta description; když chybí, použije se překlad z `seo[page]`. */
  description?: string;
  /** Příznak pro stránky mimo index (404); potlačí canonical i breadcrumbs. */
  noindex?: boolean;
}

const { locale, page, solutionId, noindex = false } = Astro.props;
const t = dictionary(locale);
const breadcrumbItems = noindex
  ? []
  : breadcrumbs(locale, page, solutionId, Astro.props.solutionTitle);
---

<!doctype html>
<html lang={locale}>
  <head>
    <SeoHead
      {locale}
      {page}
      {solutionId}
      solutionTitle={Astro.props.solutionTitle}
      title={Astro.props.title}
      description={Astro.props.description}
      {noindex}
    />
    <ThemeInit />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {t.skip}
    </a>
    <Header {locale} {page} {solutionId} />
    <main id="main-content">
      {breadcrumbItems.length > 0 && (
        <Breadcrumbs items={breadcrumbItems} label={t.common.breadcrumbs} />
      )}
      <slot />
    </main>
    <Footer {locale} />
    <script>
      import { useReveal } from "../modules/UIModule/hooks/useReveal";
      useReveal();
    </script>
  </body>
</html>
