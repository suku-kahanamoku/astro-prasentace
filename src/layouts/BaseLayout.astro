---
import SeoHead from "../modules/SiteModule/components/SeoHead.astro";

import "@fontsource-variable/manrope";
import "../styles/global.css";
import "../styles/brand.css";
import Header from "../modules/SiteModule/components/Header.astro";
import Footer from "../modules/SiteModule/components/Footer.astro";
import { dictionary } from "../modules/SiteModule/providers/translations";
import { type Locale } from "../modules/LangModule/providers/locale";
import { type PageId } from "../config/routes";

import Breadcrumbs from "../modules/UIModule/components/Breadcrumbs.astro";
import { breadcrumbs } from "../modules/SiteModule/providers/breadcrumbs";
interface Props {
  locale: Locale;
  page: PageId;
  solutionId?: string;
  solutionTitle?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { locale, page, solutionId, noindex = false } = Astro.props;
const t = dictionary(locale);
const breadcrumbItems = noindex
  ? []
  : breadcrumbs(locale, page, solutionId, Astro.props.solutionTitle);
---

<!doctype html>
<html lang={locale}>
  <head>
    <SeoHead
      {locale}
      {page}
      {solutionId}
      solutionTitle={Astro.props.solutionTitle}
      title={Astro.props.title}
      description={Astro.props.description}
      {noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {t.skip}
    </a>
    <Header {locale} {page} {solutionId} />
    <main id="main-content">
      {breadcrumbItems.length > 0 && (
        <Breadcrumbs items={breadcrumbItems} label={t.common.breadcrumbs} />
      )}
      <slot />
    </main>
    <Footer {locale} />
    <script>
      import { useReveal } from "../modules/UIModule/hooks/useReveal";
      useReveal();
    </script>
  </body>
</html>
