---
import "@fontsource-variable/manrope";
import "@/styles/global.css";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import { dictionary, locales, url, type Locale, type PageId } from "@/i18n";
import { site } from "@/config/site";
interface Props {
  locale: Locale;
  page: PageId;
  solutionId?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { locale, page, solutionId, noindex = false } = Astro.props;
const t = dictionary(locale);
const title = `${Astro.props.title || t.seo[page].title} | Prasentace`;
const description = Astro.props.description || t.seo[page].description;
const canonical = new URL(url(locale, page, solutionId), Astro.site);
const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: Astro.site?.href,
  email: site.email,
  telephone: site.phone.replaceAll(" ", ""),
  identifier: site.registrationId,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8faff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {locales.map((code) => (
          <link
            rel="alternate"
            hreflang={code}
            href={new URL(url(code, page, solutionId), Astro.site)}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(url("cs", page, solutionId), Astro.site)}
        />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Prasentace" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:locale"
      content={{ cs: "cs_CZ", en: "en_GB", de: "de_DE" }[locale]}
    />
    <meta name="twitter:card" content="summary" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {t.skip}
    </a>
    <Header {locale} {page} {solutionId} />
    <main id="main-content">
      <slot />
    </main>
    <Footer {locale} />
    <script>
      import "@/scripts/site";
    </script>
  </body>
</html>
